
# A free Postgres connection string from https://neon.tech (used for both
# local dev and production — see schema.prisma).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Real magic-link email delivery via SendGrid (HTTPS API — raw SMTP to
# Gmail doesn't work from most cloud hosts, see services/email.ts). Leave
# both unset for local dev — the link is just logged to the console
# instead. To enable real sending: sign up at sendgrid.com (free), verify
# a "Single Sender" (no domain needed — just one email you control), create
# an API key under Settings > API Keys, and set both below.
SENDGRID_API_KEY=""
EMAIL_FROM=""

# Set to "true" only when the frontend and backend are on different
# hostnames (e.g. testing over two separate tunnel URLs, or a real prod
# deployment with separate domains) — the session cookie needs
# SameSite=None + Secure in that case, or the browser silently drops it.
# Leave unset for localhost/LAN-IP dev, where both share one hostname.
COOKIE_CROSS_SITE="false"

# Generate your own with `npx web-push generate-vapid-keys` — these are
# dev-only placeholders, do not reuse them in production.
VAPID_PUBLIC_KEY="BKuwIsKBeukzwSptUGGsSyKdFXONQim4pJT5zSROao9tcnyvkBIPhG94PohMS0Dhk1VG24U6wsL-TUXP2Axy1bg"
VAPID_PRIVATE_KEY="yEnCmDBTLGnMxF1dHluKuUJspbCONvFhNAl5NEvvIHc"
VAPID_SUBJECT="mailto:support@geriatricgrooves.example"

# Required for the "Scan my space" camera feature (POST /api/scan/analyze),
# which sends the photo to Claude's vision API. Get a key from
# https://console.anthropic.com/settings/keys and set it below. Without it,
# the scan feature fails gracefully (a friendly "couldn't analyze that
# photo" message) — everything else in the app works fine without this key.
ANTHROPIC_API_KEY=""
